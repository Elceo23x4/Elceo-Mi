INTERNAL_ROUTE_TOKEN=YOUR_INTERNAL_ROUTE_TOKEN_HERE
ADMIN_INTERNAL_TOKEN=YOUR_ADMIN_INTERNAL_TOKEN_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
CSRF_SECRET=YOUR_CSRF_SECRET_HERE
RATE_LIMIT_SECRET=YOUR_RATE_LIMIT_SECRET_HERE
ELCEO_PROVIDER_MODE=fixture
ELCEO_LIVE_PROVIDER_ACTIVATION=false
ELCEO_ALLOW_LIVE_FETCHES=false
ELCEO_ALLOW_PAYMENT_PROVIDER_LIVE=false
ELCEO_ALLOW_NOTIFICATION_SENDS=false
MARKETAUX_API_KEY=YOUR_MARKETAUX_API_KEY_HERE
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY_HERE
NEWSAPI_API_KEY=YOUR_NEWSAPI_API_KEY_HERE
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY_HERE
GDELT_BASE_URL=YOUR_GDELT_BASE_URL_HERE
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
SEC_EDGAR_USER_AGENT=YOUR_SEC_EDGAR_USER_AGENT_HERE
KORAPAY_PUBLIC_KEY=YOUR_KORAPAY_PUBLIC_KEY_HERE
KORAPAY_SECRET_KEY=YOUR_KORAPAY_SECRET_KEY_HERE
KORAPAY_WEBHOOK_SECRET=YOUR_KORAPAY_WEBHOOK_SECRET_HERE
KORAPAY_WEBHOOK_SIGNATURE_HEADER=YOUR_KORAPAY_WEBHOOK_SIGNATURE_HEADER_HERE
KORAPAY_ENVIRONMENT=sandbox
PAYMENT_PROVIDER_MODE=disabled
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_API_KEY_HERE
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID_HERE
