APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
# Optional public client DSNs only; these placeholders are not credentials or auth tokens.
SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=YOUR_IMMUTABLE_RELEASE_ID_HERE
NODE_ENV=production
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
INTERNAL_API_BASE_URL=http://localhost:3000/api
APP_STATE_REPOSITORY=sql
NOTIFICATIONS_PERSISTENCE_BACKEND=sql
ANALYTICS_PERSISTENCE_BACKEND=sql
DATABASE_URL=YOUR_DATABASE_URL_HERE
REDIS_URL=YOUR_REDIS_URL_HERE
AUTH_SECRET=YOUR_AUTH_SECRET_HERE
AUTH_CREDENTIALS_ENABLED=false
ELCEO_INTERNAL_API_TOKEN=YOUR_ELCEO_INTERNAL_API_TOKEN_HERE
# Legacy deployment variables retained for backward-compatible platform configuration; runtime route guards use ELCEO_INTERNAL_API_TOKEN.
INTERNAL_ROUTE_TOKEN=YOUR_INTERNAL_ROUTE_TOKEN_HERE
ADMIN_INTERNAL_TOKEN=YOUR_ADMIN_INTERNAL_TOKEN_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
CSRF_SECRET=YOUR_CSRF_SECRET_HERE
RATE_LIMIT_SECRET=YOUR_RATE_LIMIT_SECRET_HERE
ELCEO_PROVIDER_MODE=fixture
ELCEO_LIVE_PROVIDER_ACTIVATION=false
ELCEO_ALLOW_LIVE_FETCHES=false
ELCEO_ALLOW_PAYMENT_PROVIDER_LIVE=false
ELCEO_ALLOW_NOTIFICATION_SENDS=false
MARKETAUX_API_KEY=YOUR_MARKETAUX_API_KEY_HERE
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY_HERE
NEWSAPI_API_KEY=YOUR_NEWSAPI_API_KEY_HERE
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY_HERE
GDELT_BASE_URL=YOUR_GDELT_BASE_URL_HERE
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
SEC_EDGAR_USER_AGENT=YOUR_SEC_EDGAR_USER_AGENT_HERE
KORAPAY_PUBLIC_KEY=YOUR_KORAPAY_PUBLIC_KEY_HERE
KORAPAY_SECRET_KEY=YOUR_KORAPAY_SECRET_KEY_HERE
KORAPAY_WEBHOOK_SECRET=YOUR_KORAPAY_WEBHOOK_SECRET_HERE
KORAPAY_WEBHOOK_SIGNATURE_HEADER=YOUR_KORAPAY_WEBHOOK_SIGNATURE_HEADER_HERE
KORAPAY_ENVIRONMENT=sandbox
PAYMENT_PROVIDER_MODE=disabled
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PRICE_ID_FOCUS_PLAN_MONTHLY=YOUR_STRIPE_FOCUS_PLAN_MONTHLY_PRICE_ID_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_API_KEY_HERE
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID_HERE
WHATSAPP_WEBHOOK_SECRET=YOUR_WHATSAPP_WEBHOOK_SECRET_HERE
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_FROM=YOUR_TWILIO_WHATSAPP_FROM_HERE
NOTIFICATION_SENDS_ENABLED=false
# RC-I3 notifications (live sends remain manually blocked)
NOTIFICATION_PROVIDER_MODE=disabled
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_EMAIL_FROM_ADDRESS=notifications@example.com
NOTIFICATION_EMAIL_FROM_NAME=ELCEO
NOTIFICATION_EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_WEBHOOK_SECRET=YOUR_RESEND_WEBHOOK_SECRET_HERE
POSTMARK_SERVER_TOKEN=YOUR_POSTMARK_SERVER_TOKEN_HERE
POSTMARK_WEBHOOK_USERNAME=YOUR_POSTMARK_WEBHOOK_USERNAME_HERE
POSTMARK_WEBHOOK_PASSWORD=YOUR_POSTMARK_WEBHOOK_PASSWORD_HERE
POSTMARK_MESSAGE_STREAM=outbound
NOTIFICATION_PUSH_PROVIDER=onesignal_web_push
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID_HERE
NEXT_PUBLIC_ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID_HERE
ONESIGNAL_APP_API_KEY=YOUR_ONESIGNAL_APP_API_KEY_HERE
ONESIGNAL_WEBHOOK_CORRELATION_SECRET=YOUR_ONESIGNAL_CORRELATION_SECRET_HERE

LOG_LEVEL=info
STRUCTURED_LOGGING_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ERROR_REPORTING_DSN=YOUR_ERROR_REPORTING_DSN_HERE
SECURITY_EVENT_LOGGING_ENABLED=true
ELCEO_SMOKE_BASE_URL=https://staging.example.com
# Supply only at smoke-command runtime; use the complete Cookie header value from a legitimate unexpired NextAuth session.
ELCEO_SMOKE_SESSION_COOKIE=__Secure-authjs.session-token=YOUR_SESSION_TOKEN_HERE
ELCEO_STAGING_BASE_URL=https://staging.example.com
