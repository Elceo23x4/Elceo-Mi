TWILIO_WHATSAPP_FROM=YOUR_TWILIO_WHATSAPP_FROM_HERE
NOTIFICATION_SENDS_ENABLED=false
LOG_LEVEL=info
STRUCTURED_LOGGING_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ERROR_REPORTING_DSN=YOUR_ERROR_REPORTING_DSN_HERE
SECURITY_EVENT_LOGGING_ENABLED=true
ELCEO_SMOKE_BASE_URL=https://staging.example.com
# Supply only at smoke-command runtime; use the complete Cookie header value from a legitimate unexpired NextAuth session.
ELCEO_SMOKE_SESSION_COOKIE=__Secure-authjs.session-token=YOUR_SESSION_TOKEN_HERE
ELCEO_STAGING_BASE_URL=https://staging.example.com
