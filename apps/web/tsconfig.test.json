{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-test",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "app/**/*.ts",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    "components/**/*.ts"
  ]
}
