{
  "name": "elceo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "dev": "npm run dev -w apps/web",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test && node scripts/security-rc-j-self-test.mjs",
    "check:runtime": "node scripts/check-runtime-contract.mjs",
    "check:dependency-compatibility": "node scripts/check-dependency-compatibility.mjs",
    "check:sharp-exception-upstream": "node scripts/check-sharp-exception-upstream.mjs",
    "audit:image-ingress": "node scripts/audit-image-ingress.mjs",
    "test:sharp": "node scripts/test-sharp-runtime.mjs",
    "test:svg": "node scripts/test-svg-pipeline.mjs",
    "test:next-image": "node scripts/test-next-image-runtime.mjs",
    "test:next-image-concurrency": "node scripts/test-next-image-concurrency.mjs",
    "format": "npm run --workspaces --if-present format",
    "quality-gate": "npm run typecheck && npm run test",
    "smoke:production": "node scripts/production-smoke-test.mjs",
    "check:migrations": "node scripts/check-db-migrations.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "check:c5-readiness": "node scripts/check-c5-readiness.mjs",
    "security:gate": "node scripts/security-gate.mjs",
    "check:infra-security": "node scripts/check-infra-security-policy.mjs",
    "attack-drill:staging": "node scripts/attack-drill-staging.mjs",
    "check:landing-assets": "node scripts/check-elceo-landing-assets.mjs",
    "qa:landing:screenshot": "node scripts/capture-elceo-landing.mjs",
    "rehearse:migrations:dry-run": "ELCEO_MIGRATION_DRY_RUN=1 node scripts/rehearse-db-migrations.mjs",
    "test:migrations": "node --test test/migrations.test.mjs && node scripts/verify-db-references.mjs",
    "provider:replay-smoke": "node scripts/provider-replay-smoke.mjs",
    "provider:staging-smoke": "node scripts/provider-staging-smoke.mjs",
    "payment:replay-smoke": "node scripts/payment-provider-replay-smoke.mjs",
    "payment:sandbox-smoke": "node scripts/payment-provider-sandbox-smoke.mjs",
    "notification:replay-smoke": "node scripts/notification-replay-smoke.mjs",
    "notification:sandbox-smoke": "node scripts/notification-sandbox-smoke.mjs",
    "verify:staging-isolation": "node scripts/verify-staging-isolation.mjs",
    "monitoring:alert-smoke": "node scripts/monitoring-alert-smoke.mjs",
    "backup:restore-rehearsal": "node scripts/rehearse-backup-restore.mjs",
    "rollback:rehearsal": "node scripts/rehearse-rollback.mjs",
    "verify:deployment-gates": "node scripts/verify-deployment-promotion-gates.mjs",
    "check:ifp": "node scripts/check-intelligence-feature-program.mjs",
    "test:ifp3-postgres": "npm run -w services/reasoning test && node scripts/test-ifp3-postgres.mjs",
    "test:ifp4-postgres": "npm run -w services/reasoning test && node scripts/test-ifp4-postgres.mjs",
    "test:ifp5-postgres": "npm run -w services/reasoning test && node scripts/test-ifp5-postgres.mjs"
  },
  "engines": {
    "node": "24.x",
    "npm": "10.8.2"
  },
  "devDependecies": {
    "typescript": "^5.9.3",
    "eslint": "^9.39.4",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.58.2",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "eslint-config-next": "15.5.15"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@svgr/webpack": "^8.1.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "playwright": "^1.59.1",
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.1",
    "@svgr/plugin-svgo": {
      "svgo": "3.3.4"
    },
    "next": {
      "postcss": "8.5.25"
    }
  }
}
