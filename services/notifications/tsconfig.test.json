    "moduleResolution": "Node",
    "outDir": "dist-test",
    "rootDir": "../../"
  },
  "include": [
    "src/tests/**/*.ts",
    "src/policy/**/*.ts",
    "src/persistence/**/*.ts",
    "src/delivery/**/*.ts",
