{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@elceo/config": [
        "packages/config/src/index.ts"
      ],
      "@elceo/schemas": [
        "packages/schemas/src/index.ts"
      ],
      "@elceo/types": [
        "packages/types/src/index.ts"
      ],
      "@elceo/providers": [
        "packages/providers/src/index.ts"
      ],
      "@elceo/domain": [
        "packages/domain/src/index.ts"
      ],
      "@elceo/ui": [
        "packages/ui/src/index.ts"
      ],
      "@elceo/motion": [
        "packages/motion/src/index.ts"
      ],
      "@elceo/ingestion": [
        "services/ingestion/src/index.ts"
      ],
      "@elceo/chart-intelligence": [
        "services/chart-intelligence/src/index.ts"
      ],
      "@elceo/reasoning": [
        "services/reasoning/src/index.ts"
      ],
      "@elceo/application-state": [
        "services/application-state/src/index.ts"
      ],
      "@elceo/notifications": [
        "services/notifications/src/index.ts"
      ],
      "@elceo/admin-jobs": [
        "services/admin-jobs/src/index.ts"
      ],
      "@elceo/analytics": [
        "services/analytics/src/index.ts"
      ],
      "@elceo/billing": [
        "services/billing/src/index.ts"
      ]
    }
  }
}
